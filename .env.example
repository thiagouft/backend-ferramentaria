# Conexão com o Banco de Dados SQL Server
# Formato: sqlserver://<HOST>:<PORTA>;database=<NOME_BANCO>;user=<USUARIO>;password=<SENHA>;encrypt=true;trustServerCertificate=true;
DATABASE_URL="sqlserver://127.0.0.1:1433;database=ferramentaria_cprt;user=sa;password=sua_senha_aqui;encrypt=true;trustServerCertificate=true;"

# Chave secreta para assinatura e validação dos tokens JWT (gere uma chave forte e aleatória)
JWT_SECRET="insira_uma_chave_secreta_jwt_longa_e_segura_aqui"

# Credenciais de acesso ao portal Dimep AMS para rotinas de sincronização automática com Puppeteer
AUTOSYNC_USER="usuario_dimep_ams"
AUTOSYNC_PASS="senha_dimep_ams"

# Configurações do Servidor HTTP Fastify
PORT=3333
HOST="0.0.0.0"
